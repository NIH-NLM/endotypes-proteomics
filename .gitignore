# ── what is committed, and what is not ────────────────────────────────────
#
#   proteins/   COMMITTED. Curated prior knowledge: gene sets the analysis is
#               interpreted against, not derived from.
#   ipynb/      COMMITTED, and holds notebooks and nothing else.
#   src/        COMMITTED. R that is not a notebook.
#
#   data/       NOT committed. The study download, and data/run_artifacts/,
#               which holds everything a run can regenerate. Delete it and
#               ./run_all.sh rebuilds it.

# study data and every regenerable artifact
data/
cohorts/
.ipynb_checkpoints/

# ipynb/ holds notebooks. Anything else that lands there is a stray -- the
# cohort CSVs live in cohorts/ now, and run output in data/run_artifacts/.
ipynb/artifacts/
ipynb/*.csv
ipynb/*.rds
ipynb/*.png
ipynb/*.svg
ipynb/*.pdf
ipynb/*.html
ipynb/.ipynb_checkpoints/

# R
permutedStats-*.RData          # WGCNA modulePreservation cache
.Rhistory
.RData
.Rproj.user/

# macOS
.DS_Store
